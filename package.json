{
  "name": "salary-management",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @salary/db db:migrate",
    "db:seed": "pnpm --filter @salary/db db:seed"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.13"
  }
}
